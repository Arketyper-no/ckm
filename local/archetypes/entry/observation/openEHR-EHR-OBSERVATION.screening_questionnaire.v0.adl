archetype (adl_version=1.4; uid=a04ff8f1-56bd-4d5a-84c0-e1aad91269f5)
	openEHR-EHR-OBSERVATION.screening_questionnaire.v0

concept
	[at0000]	-- Generic screening questionnaire
language
	original_language = <[ISO_639-1::en]>
	translations = <
		["nb"] = <
			language = <[ISO_639-1::nb]>
			author = <
				["name"] = <"John Tore Valand">
				["organisation"] = <"Helse Vest IKT">
				["email"] = <"john.tore.valand@helse-vest-ikt.no">
			>
		>
	>
description
	original_author = <
		["name"] = <"Silje Ljosland Bakke">
		["organisation"] = <"Helse Vest IKT AS">
		["email"] = <"silje.ljosland.bakke@helse-vest-ikt.no">
		["date"] = <"2026-08-10">
	>
	details = <
		["nb"] = <
			language = <[ISO_639-1::nb]>
			purpose = <"For å lage et rammeverk for registrering av svar på forhåndsdefinerte spørsmål til generell kartlegging, der spørsmålene og kartleggingsformålet defineres på templatnivå.">
			use = <"Brukes for å lage et rammeverk for registrering av svar på forhåndsdefinerte spørsmål til generell kartlegging, der spørsmålene og kartleggingsformålet defineres på templatnivå.

Vanlige bruksområder inkluderer, men er ikke begrenset til:
- lokalt definerte sjekklister eller spørreskjemaer der det ikke finnes en domenespesifikk kartleggingsarketype, for eksempel:
--- Trenger du hotell? Ja, Nei, Ukjent, Usikker.
--- Trenger pasienten ledsager? Ja, Nei, Ukjent, Usikker.

Hvert spørsmål registreres som én instans av CLUSTER.screening_question, sammen med svaret som ble gitt. I et templat vil dataelementet \"Svar\" i CLUSTER.screening_question vanligvis døpes om til spørsmålet slik det ble stilt til individet, og den fullstendige spørsmålsteksten kan i tillegg registreres i dataelementet \"Spørsmål\". Dataelementene \"Kategori\" og \"Relatert kode\" angir den maskinlesbare betydningen av spørsmålet. Oppfølgingsspørsmål som bare stilles, eller bare gir mening, ved et bestemt svar på det overordnede spørsmålet, registreres som nøstede instanser av CLUSTER.screening_question i SLOTet \"Underspørsmål\" i det overordnede spørsmålet.

Bruk dataelementet \"Kartleggingsformål\" for å registrere konteksten eller årsaken for kartleggingen. Dataelementet gir kontekst dersom man senere ønsker å gjøre spørringer på dataene, og er normalt ikke synlig for individet som kartlegges.

Semantikken til denne arketypen er med vilje løst definert, og spørringer etter data i denne arketypen vil normalt bare være hensiktsmessig eller sikkert i konteksten av det spesifikke templatet. I motsetning til de domenespesifikke kartleggingsarketypene har denne arketypen ingen fast klinisk semantikk eller bundne verdisett, og den er verken en generisk overordnet arketype for, eller en erstatning for, disse arketypene.

Bruk separate EVENT-er for å angi om spørsmålene gjelder et tidspunkt eller et tidsintervall. For eksempel: \"Trenger du hotell?\" som en tidspunkthendelse og \"Har du byttet fastlege i løpet av det siste året?\" som en intervallhendelse.

Kilden til informasjonen i et spørreskjema kan variere i ulike kontekster, men kan identifiseres spesifikt ved å benytte elementet \"Information provider\" i openEHR referansemodellen.

Denne arketypen er laget for å bli brukt i et spørreskjema eller for å registrere enkle strukturerte data til for eksempel et sykdomsregister. Arketypen registrerer at et spørsmål ble stilt og hva som ble svart, men ikke den kliniske konklusjonen som trekkes ut fra svaret. Dersom det i kartleggingen identifiseres noe som bør lagres i pasientjournalen, anbefales det at dette registreres og lagres i arketyper som er spesifikke for det kliniske formålet.">
			keywords = <"kartlegging", "spørreskjema", "screening", "vurdering", "spørsmål", "svar", "skjema", "spørreundersøkelse">
			misuse = <"Brukes ikke for å registrere skårer, skalaer eller andre validerte vurderingsinstrumenter. Bruk en egnet arketype for skåren eller skalaen for dette formålet.

Brukes ikke for å registrere kliniske funn som har egne arketyper, for eksempel problemer, diagnoser eller symptomer. Bruk arketypen som er spesifikk for det kliniske funnet, for eksempel EVALUATION.problem_diagnosis (Problem/diagnose) eller CLUSTER.symptom_sign, for dette formålet.">
			copyright = <"© openEHR Norway">
		>
		["en"] = <
			language = <[ISO_639-1::en]>
			purpose = <"To create a framework for recording answers to pre-defined screening questions used for general screening where the questions and screening purpose are defined at the template level.

">
			use = <"Use to create a framework for recording answers to pre-defined screening questions used for general screening where the questions and screening purpose are defined at the template level.

Common use cases include, but are not limited to:
- Locally defined checklists or questionnaires where no domain-specific screening questionnaire archetype is available, for example:
--- Do you need a hotel? Yes, No, Unknown, Unsure.
--- Does the patient need an escort? Yes, No, Unknown, Unsure.

Each question is recorded as one instance of CLUSTER.screening_question, together with the answer given. In a template, the 'Answer' data element in CLUSTER.screening_question would usually be renamed to the question as put to the individual, and the full question text may also be recorded in the 'Question' data element. The 'Category' and 'Related code' data elements carry the machine-readable meaning of the question. Follow-up questions that are only asked, or only meaningful, given a particular answer to the parent question are recorded as nested instances of CLUSTER.screening_question within the 'Sub-question' SLOT of the parent question.

Use the 'Screening purpose' data element to record the context or reason for the screening. This data element provides context when the data are queried at a later date, and is not normally shown to the individual being screened.

The semantics of this archetype are intentionally loose, and querying this archetype would normally only be useful or safe within the context of each specific template. Unlike the domain-specific screening questionnaire archetypes, this archetype has no fixed clinical semantics or bound value sets, and it is neither a generic parent of, nor a substitute for, those archetypes.

Use separate EVENTs to specify whether the questions relate to a point in time or an interval of time. For example: 'Do you need a hotel?' as a point-in-time EVENT and 'Have you changed your general practitioner during the past year?' as an interval EVENT.

The source of the information in a questionnaire response may vary in different contexts, but can be specifically identified using the 'Information provider' element in the Reference Model.

This archetype has been designed to be used as a screening tool, or to record simple questionnaire-format data for use in situations such as a disease registry. It records that a question was asked and what was answered; it does not record the clinical conclusion drawn from the answer. If the screening process identifies something that should be persisted as part of an ongoing health record, it is recommended that this is recorded using archetypes specific for the clinical purpose.">
			keywords = <"screening", "questionnaire", "assessment", "question", "answer", "form", "survey">
			misuse = <"Not to be used to record scores, scales or other validated assessment instruments. Use a specific score or scale archetype for this purpose.

Not to be used as a general-purpose container for clinical findings which have their own archetypes, such as problems, diagnoses or symptoms. Use the archetype specific for the clinical finding, such as EVALUATION.problem_diagnosis or CLUSTER.symptom_sign, for this purpose.">
			copyright = <"© openEHR Norway">
		>
	>
	lifecycle_state = <"in_development">
	other_contributors = <>
	other_details = <
