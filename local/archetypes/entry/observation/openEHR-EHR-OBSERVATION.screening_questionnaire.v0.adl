		["custodian_organisation"] = <"openEHR Norge">
		["references"] = <"Medication screening questionnaire, Published archetype [Internet]. openEHR Foundation, openEHR Clinical Knowledge Manager [cited: 2026-08-10]. Available from: https://ckm.openehr.org/ckm/archetypes/1013.1.4677">
		["original_namespace"] = <"no.openehr">
