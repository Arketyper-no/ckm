definition
	OBSERVATION[at0000] matches {    -- Quality of recovery (QoR-15)
		data matches {
			HISTORY[at0001] matches {    -- History
				events cardinality matches {1..*; unordered} matches {
					EVENT[at0002] matches {    -- Any event
						data matches {
							ITEM_TREE[at0003] matches {    -- Tree
								items cardinality matches {0..*; unordered} matches {
									CLUSTER[at0019] occurrences matches {0..1} matches {    -- Part A
										items cardinality matches {1..*; unordered} matches {
											ELEMENT[at0353] occurrences matches {0..1} matches {    -- How have you been feeling in the last 24 hours?
												value matches {
													DV_TEXT matches {*}
												}
											}
											ELEMENT[at0004] occurrences matches {0..1} matches {    -- 1. Able to breathe easily
												value matches {
													0|[local::at0188],
													1|[local::at0189],
													2|[local::at0190],
													3|[local::at0191],
													4|[local::at0192],
													5|[local::at0193],
													6|[local::at0194],
													7|[local::at0195],
													8|[local::at0196],
													9|[local::at0197],
													10|[local::at0198]
												}
											}
											ELEMENT[at0005] occurrences matches {0..1} matches {    -- 2. Been able to enjoy food
												value matches {
													0|[local::at0199],
													1|[local::at0200],
													2|[local::at0201],
													3|[local::at0202],
													4|[local::at0203],
													5|[local::at0204],
													6|[local::at0205],
													7|[local::at0206],
													8|[local::at0207],
													9|[local::at0208],
													10|[local::at0209]
												}
											}
											ELEMENT[at0006] occurrences matches {0..1} matches {    -- 3. Feeling rested
												value matches {
													0|[local::at0210],
													1|[local::at0211],
													2|[local::at0212],
													3|[local::at0213],
													4|[local::at0214],
													5|[local::at0215],
													6|[local::at0216],
													7|[local::at0217],
													8|[local::at0218],
													9|[local::at0219],
													10|[local::at0220]
												}
											}
											ELEMENT[at0007] occurrences matches {0..1} matches {    -- 4. Have a good sleep
												value matches {
													0|[local::at0221],
													1|[local::at0222],
													2|[local::at0223],
													3|[local::at0224],
													4|[local::at0225],
													5|[local::at0226],
													6|[local::at0227],
													7|[local::at0228],
													8|[local::at0229],
													9|[local::at0230],
													10|[local::at0231]
												}
											}
											ELEMENT[at0008] occurrences matches {0..1} matches {    -- 5. Able to look after personal toilet and hygiene unaided
												value matches {
													0|[local::at0232],
													1|[local::at0233],
													2|[local::at0234],
													3|[local::at0235],
													4|[local::at0236],
													5|[local::at0237],
													6|[local::at0238],
													7|[local::at0239],
													8|[local::at0240],
													9|[local::at0241],
													10|[local::at0242]
												}
											}
											ELEMENT[at0009] occurrences matches {0..1} matches {    -- 6. Able to communicate with family or friends
												value matches {
													0|[local::at0243],
													1|[local::at0244],
													2|[local::at0245],
													3|[local::at0246],
													4|[local::at0247],
													5|[local::at0248],
													6|[local::at0249],
													7|[local::at0250],
													8|[local::at0251],
													9|[local::at0252],
													10|[local::at0253]
												}
											}
											ELEMENT[at0010] occurrences matches {0..1} matches {    -- 7. Getting support from hospital doctors and nurses
												value matches {
													0|[local::at0254],
													1|[local::at0255],
													2|[local::at0256],
													3|[local::at0257],
													4|[local::at0258],
													5|[local::at0259],
													6|[local::at0260],
													7|[local::at0261],
													8|[local::at0262],
													9|[local::at0263],
													10|[local::at0264]
												}
											}
											ELEMENT[at0011] occurrences matches {0..1} matches {    -- 8. Able to return to work or usual home activities
												value matches {
													0|[local::at0265],
													1|[local::at0266],
													2|[local::at0267],
													3|[local::at0268],
													4|[local::at0269],
													5|[local::at0270],
													6|[local::at0271],
													7|[local::at0272],
													8|[local::at0273],
													9|[local::at0274],
													10|[local::at0275]
												}
											}
											ELEMENT[at0012] occurrences matches {0..1} matches {    -- 9. Feeling comfortable and in control
												value matches {
													0|[local::at0276],
													1|[local::at0277],
													2|[local::at0278],
													3|[local::at0279],
													4|[local::at0280],
													5|[local::at0281],
													6|[local::at0282],
													7|[local::at0283],
													8|[local::at0284],
													9|[local::at0285],
													10|[local::at0286]
												}
											}
											ELEMENT[at0013] occurrences matches {0..1} matches {    -- 10. Having a feeling of general well-being
												value matches {
													0|[local::at0287],
													1|[local::at0288],
													2|[local::at0289],
													3|[local::at0290],
													4|[local::at0291],
													5|[local::at0292],
													6|[local::at0293],
													7|[local::at0294],
													8|[local::at0295],
													9|[local::at0296],
													10|[local::at0297]
												}
											}
										}
									}
									CLUSTER[at0021] occurrences matches {0..1} matches {    -- Part B
										items cardinality matches {1..*; unordered} matches {
											ELEMENT[at0354] occurrences matches {0..1} matches {    -- Have you had any of the following in the last 24 hours?
												value matches {
													DV_TEXT matches {*}
												}
											}
											ELEMENT[at0014] occurrences matches {0..1} matches {    -- 11. Moderate pain
												value matches {
													10|[local::at0298],
													9|[local::at0299],
													8|[local::at0300],
													7|[local::at0301],
													6|[local::at0302],
													5|[local::at0303],
													4|[local::at0304],
													3|[local::at0305],
													2|[local::at0306],
													1|[local::at0307],
													0|[local::at0308]
												}
											}
											ELEMENT[at0015] occurrences matches {0..1} matches {    -- 12. Severe pain
												value matches {
													10|[local::at0309],
													9|[local::at0310],
													8|[local::at0311],
													7|[local::at0312],
													6|[local::at0313],
													5|[local::at0314],
													4|[local::at0315],
													3|[local::at0316],
													2|[local::at0317],
													1|[local::at0318],
													0|[local::at0319]
												}
											}
											ELEMENT[at0016] occurrences matches {0..1} matches {    -- 13. Nausea or vomiting
												value matches {
													10|[local::at0320],
													9|[local::at0321],
													8|[local::at0322],
													7|[local::at0323],
													6|[local::at0324],
													5|[local::at0325],
													4|[local::at0326],
													3|[local::at0327],
													2|[local::at0328],
													1|[local::at0329],
													0|[local::at0330]
												}
											}
											ELEMENT[at0017] occurrences matches {0..1} matches {    -- 14. Feeling worried or anxious
												value matches {
													10|[local::at0331],
													9|[local::at0332],
													8|[local::at0333],
													7|[local::at0334],
													6|[local::at0335],
													5|[local::at0336],
													4|[local::at0337],
													3|[local::at0338],
													2|[local::at0339],
													1|[local::at0340],
													0|[local::at0341]
												}
											}
											ELEMENT[at0018] occurrences matches {0..1} matches {    -- 15. Feeling sad or depressed
												value matches {
													10|[local::at0342],
													9|[local::at0343],
													8|[local::at0344],
													7|[local::at0345],
													6|[local::at0346],
													5|[local::at0347],
													4|[local::at0348],
													3|[local::at0349],
													2|[local::at0350],
													1|[local::at0351],
													0|[local::at0352]
												}
											}
										}
									}
									ELEMENT[at0022] occurrences matches {0..1} matches {    -- Total score
										value matches {
											DV_COUNT matches {*}
										}
									}
								}
							}
						}
					}
				}
			}
		}
		protocol matches {
			ITEM_TREE[at0020] matches {*}    -- Item tree
		}
	}


ontology
	term_definitions = <
		["en"] = <
			items = <
				["at0000"] = <
					text = <"Quality of recovery (QoR-15)">
					description = <"Patient-reported recovery assessment.">
				>
				["at0001"] = <
					text = <"History">
					description = <"@ internal @">
				>
				["at0002"] = <
					text = <"Any event">
					description = <"@ internal @">
				>
				["at0003"] = <
					text = <"Tree">
					description = <"@ internal @">
				>
				["at0004"] = <
					text = <"1. Able to breathe easily">
					description = <"Self-rated perception of ability to breathe easily.">
					comment = <"0 represents 'None of the time' [poor] and 10 represents 'All of the time' [excellent]. ">
				>
				["at0005"] = <
					text = <"2. Been able to enjoy food">
					description = <"Self-rated perception of ability to enjoy food.">
					comment = <"0 represents 'None of the time' [poor] and 10 represents 'All of the time' [excellent]. ">
				>
				["at0006"] = <
					text = <"3. Feeling rested">
					description = <"Self-rated perception of feeling rested.">
					comment = <"0 represents 'None of the time' [poor] and 10 represents 'All of the time' [excellent]. ">
				>
				["at0007"] = <
					text = <"4. Have a good sleep">
					description = <"Self-rated perception of ability to sleep well.">
					comment = <"0 represents 'None of the time' [poor] and 10 represents 'All of the time' [excellent]. ">
				>
				["at0008"] = <
					text = <"5. Able to look after personal toilet and hygiene unaided">
					description = <"Self-rated perception of ability to look after personal toilet and hygiene unaided.">
					comment = <"0 represents 'None of the time' [poor] and 10 represents 'All of the time' [excellent]. ">
				>
				["at0009"] = <
					text = <"6. Able to communicate with family or friends">
					description = <"Self-rated perception of ability to communicate with family or friends.">
					comment = <"0 represents 'None of the time' [poor] and 10 represents 'All of the time' [excellent]. ">
				>
				["at0010"] = <
					text = <"7. Getting support from hospital doctors and nurses">
					description = <"Self-rated perception of getting support from hospital doctors and nurses.">
					comment = <"0 represents 'None of the time' [poor] and 10 represents 'All of the time' [excellent]. ">
				>
				["at0011"] = <
					text = <"8. Able to return to work or usual home activities">
					description = <"Self-rated perception of ability to return to work or usual home activities.">
					comment = <"0 represents 'None of the time' [poor] and 10 represents 'All of the time' [excellent]. ">
				>
				["at0012"] = <
					text = <"9. Feeling comfortable and in control">
					description = <"Self-rated perception of feeling comfortable and in control.">
					comment = <"0 represents 'None of the time' [poor] and 10 represents 'All of the time' [excellent]. ">
				>
				["at0013"] = <
					text = <"10. Having a feeling of general well-being">
					description = <"Self-rated perception of general well-being.">
					comment = <"0 represents 'None of the time' [poor] and 10 represents 'All of the time' [excellent]. ">
				>
				["at0014"] = <
					text = <"11. Moderate pain">
					description = <"Self-rated perception of moderate pain.">
					comment = <"10 represents 'None of the time' [excellent] and 0 represents 'All of the time' [poor]. ">
				>
				["at0015"] = <
					text = <"12. Severe pain">
					description = <"Self-rated perception of severe pain.">
					comment = <"10 represents 'None of the time' [excellent] and 0 represents 'All of the time' [poor]. ">
				>
				["at0016"] = <
					text = <"13. Nausea or vomiting">
					description = <"Self-rated perception of nausea or vomiting.">
					comment = <"10 represents 'None of the time' [excellent] and 0 represents 'All of the time' [poor]. ">
				>
				["at0017"] = <
					text = <"14. Feeling worried or anxious">
					description = <"Self-rated perception of feeling worried or anxious.">
					comment = <"10 represents 'None of the time' [excellent] and 0 represents 'All of the time' [poor]. ">
				>
				["at0018"] = <
					text = <"15. Feeling sad or depressed">
					description = <"Self-rated perception of feeling sad or depressed.">
					comment = <"10 represents 'None of the time' [excellent] and 0 represents 'All of the time' [poor]. ">
				>
				["at0019"] = <
					text = <"Part A">
					description = <"">
				>
				["at0020"] = <
					text = <"Item tree">
					description = <"@ internal @">
				>
				["at0021"] = <
