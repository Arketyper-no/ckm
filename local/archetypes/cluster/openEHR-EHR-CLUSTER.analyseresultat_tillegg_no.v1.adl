archetype (adl_version=1.4; uid=c1abb923-ff3d-4990-9a70-28840f094a2c)
	openEHR-EHR-CLUSTER.analyseresultat_tillegg_no.v1

concept
	[at0000]	-- Analyseresultattillegg
language
	original_language = <[ISO_639-1::nb]>
description
	original_author = <
		["name"] = <"Vebjørn Arntzen">
		["organisation"] = <"Oslo universitetssykehus HF">
		["email"] = <"varntzen@ous-hf.no">
		["date"] = <"2026-06-30">
	>
	details = <
		["nb"] = <
			language = <[ISO_639-1::nb]>
			purpose = <"Brukes for å representere særnorske krav til analyseresultat når de sendes som elektroniske meldinger.">
			use = <"Bruk for å representere særnorske krav til analyseresultat når de sendes som elektroniske meldinger.

Elementet \"Resultatidentifikator\" brukes til å identifisere entydig og skille mellom individuelle analyseresultater innenfor samme rapport. Når flere resultater finnes for samme undersøkelse, angir ID-en deres kronologiske rekkefølge: 
Id = 1 representerer det eldste resultatet
Id = 2 det nest eldste
og så videre.

Elementet \"Referanse resultatidentifikator\" brukes til å henvise til et annet analyseresultat ved å peke på dets tilhørende \"Resultatidentifikator\". Dette muliggjør strukturerte relasjoner mellom funn innenfor samme rapport og er særlig viktig i medisinsk mikrobiologi, der funn av organismer og resultater for antimikrobiell resistens må kobles korrekt.

Arketypen er tenkt inkludert i elementet \"Tilleggsinformasjon\" i arketypen Laboratorieresultat (OBSERVATION.laboratory_test_result).">
			misuse = <"Skal ikke brukes til annet enn som et tillegg til arketypen Laboratorieresultat (OBSERVATION.laboratory_test_result).">
			copyright = <"openEHR Norge">
		>
	>
	lifecycle_state = <"published">
	other_contributors = <"Liv Laugen, Oslo universitetssykehus HF", ...>
	other_details = <
		["licence"] = <"This work is licensed under the Creative Commons Attribution-ShareAlike 4.0 International License. To view a copy of this license, visit http://creativecommons.org/licenses/by-sa/4.0/.">
		["custodian_organisation"] = <"openEHR Foundation">
		["references"] = <"https://www.helsedirektoratet.no/standarder/svarrapportering-av-medisinske-tjenester-v1.4">
		["original_namespace"] = <"org.openehr">
		["original_publisher"] = <"openEHR Foundation">
		["custodian_namespace"] = <"org.openehr">
		["MD5-CAM-1.0.1"] = <"1DF5BE842C28526DADF4EF836501D83A">
		["build_uid"] = <"8a07fdde-1bd2-4fe1-b860-9b8937072f73">
		["revision"] = <"1.0.0">
	>

definition
	CLUSTER[at0000] matches {    -- Analyseresultattillegg
		items cardinality matches {1..*; unordered} matches {
			ELEMENT[at0001] occurrences matches {0..1} matches {    -- Resultatidentifikator
				value matches {
					DV_TEXT matches {*}
					DV_IDENTIFIER matches {*}
					DV_URI matches {*}
				}
			}
			ELEMENT[at0002] occurrences matches {0..1} matches {    -- Referanse til resultatidentifikator
				value matches {
					DV_TEXT matches {*}
					DV_IDENTIFIER matches {*}
					DV_URI matches {*}
				}
			}
		}
	}


ontology
	term_definitions = <
		["nb"] = <
			items = <
				["at0000"] = <
					text = <"Analyseresultattillegg">
					description = <"Tillegg til arketypen Analyseresultat (CLUSTER.laboratory_test_analyte) til bruk for å representere særnorske krav til analyseresultat når de sendes som elektroniske meldinger.">
				>
				["at0001"] = <
					text = <"Resultatidentifikator">
					description = <"En unik identifikator som brukes for å kunne referere til et spesifikt analyttresultat innenfor samme laboratoriesvarrapport.">
					comment = <"Angir en identifikator for et analyttresultat innenfor samme laboratoriesvarrapport. Kan refereres til gjennom elementet \"Referanse til resultatidentifikator\" for å etablere koblinger mellom relaterte analyttresultater, for eksempel ved avledede beregninger, panel-/analysepakkesammensetning eller andre relasjoner mellom resultater. Dette tilsvarer \"IdResultItem\" i den norske meldingsspesifikasjonen.">
				>
				["at0002"] = <
					text = <"Referanse til resultatidentifikator">
					description = <"En referanse til Resultatidentifikator for et annet analyttresultat innenfor samme laboratoriesvarrapport.">
					comment = <"Benyttes for å koble analyttresultater mot det aktuelle analyttresultatets Resultatidentifikator for å støtte relasjoner mellom resultater. Dette tilsvarer \"RefIdResultItem\" i den norske meldingsspesifikasjonen.">
				>
			>
		>
	>
