	>

definition
	CLUSTER[at0000] matches {    -- Analyseresultat_tillegg_no
		items cardinality matches {1..*; unordered} matches {
			ELEMENT[at0001] occurrences matches {0..1} matches {    -- Resultatidentifikator
				value matches {
					DV_TEXT matches {*}
					DV_IDENTIFIER matches {*}
					DV_URI matches {*}
				}
			}
			ELEMENT[at0002] occurrences matches {0..1} matches {    -- Referanse resultatidentifikator
				value matches {
					DV_TEXT matches {*}
					DV_IDENTIFIER matches {*}
					DV_URI matches {*}
				}
			}
		}
	}


ontology
	term_definitions = <
		["nb"] = <
			items = <
				["at0000"] = <
					text = <"Analyseresultat_tillegg_no">
					description = <"Tillegg til arketypen Analyseresultat (CLUSTER.laboratory_test_analyte.v1) til bruk for å representere særnorske krav til analyseresultat når de sendes som elektroniske meldinger.">
				>
				["at0001"] = <
					text = <"Resultatidentifikator">
					description = <"En unik identifikator som brukes til å skille og referere til et bestemt analyttesultat innenfor samme laboratoriesvarrapport.">
					comment = <"Angir en identifikator som muliggjør eksplisitt kobling mellom relaterte analyseresultater, ved at andre analyser kan referere til den gjennom elementet Referanse resultatidentifikator elementet (for eksempel for avledede beregninger, panel‑sammensetning eller ‘kilde‑til’‑relasjoner). Dette tilsvarer \"IdResultItem\" i den norske meldingsspesifikasjonen.">
				>
				["at0002"] = <
					text = <"Referanse resultatidentifikator">
					description = <"En referanse til identifikatoren til et annet analyttresultat innenfor samme laboratoriesvarrapport.">
					comment = <"Støtter eksplisitt, strukturert kobling mellom relaterte analytt-resultater ved å peke til  den tilhørende Resultatidentifikator for undersøkelsen. Dette tilsvarer \"RefIdResultItem\" i den norske meldingsspesifikasjonen.">
				>
			>
		>
	>
