definition
	CLUSTER[at0000] matches {    -- Gustilo-Anderson Classification
		items cardinality matches {1..*; unordered} matches {
			ELEMENT[at0012] occurrences matches {0..1} matches {    -- Classification
				value matches {
					DV_CODED_TEXT matches {
						defining_code matches {
							[local::
							at0013,    -- Type 1
							at0014,    -- Type 2
							at0015,    -- Type 3a
							at0016,    -- Type 3b
							at0017]    -- Type 3c
						}
					}
				}
			}
		}
	}

ontology
	term_definitions = <
		["nb"] = <
			items = <
				["at0000"] = <
					text = <"Gustilio-Andersons klassifikasjon">
					description = <"Revidert utgave av den originale Gustilo-Anderson klassifiseringen av åpne bruddskader som ble introdusert i 1976.">
				>
				["at0012"] = <
					text = <"Grad">
					description = <"Gradering av hudåpning og alvorlighetsgrad">
				>
				["at0013"] = <
					text = <"Grad I">
					description = <"Lavenergi. Stikksår (skarp bruddkant). Sårets lengde mindre enn 1 cm.">
				>
				["at0014"] = <
					text = <"Grad II">
					description = <"Lavenergi. Sår større enn 1 cm og mindre enn 5 cm. Ingen huddefekt eller større bløtdelsskade.">
				>
				["at0015"] = <
					text = <"Grad IIIa">
					description = <"Høyenergiskade med adekvat bløtdelsdekning av frakturert ben.">
				>
				["at0016"] = <
					text = <"Grad IIIb">
					description = <"Høyenergiskade med bløtdelsdefekter. Blottet ben og periostal stripping. Ofte stor kontaminering.">
				>
				["at0017"] = <
					text = <"Grad III">
					description = <"Åpent brudd med arterieskade som trenger reparasjon, uansett størrelse på bløtdelsskaden.">
				>
			>
		>
		["en"] = <
			items = <
				["at0000"] = <
					text = <"Gustilo-Anderson Classification">
					description = <"A revised classification of the severity of open fracture injuries based on the Gustilo-Anderson Classification that was introdused in 1976.">
				>
				["at0012"] = <
					text = <"Classification">
					description = <"">
				>
				["at0013"] = <
					text = <"Type 1">
					description = <"Open fracture with a clean wound less than 1 cm in length and minimal soft tissue damage.">
				>
				["at0014"] = <
					text = <"Type 2">
					description = <"Open fracture with a wound greater than 1 cm in length, without extensive soft tissue damage, flaps, avulsions, or severe contamination.">
				>
				["at0015"] = <
					text = <"Type 3a">
					description = <"Adequate soft-tissue coverage of a fractured bone despite extensive soft-tissue laceration or flaps, or high-energy trauma irrespective of the size of the wound.">
				>
				["at0016"] = <
					text = <"Type 3b">
					description = <"Extensive soft-tissue injury with periosteal stripping and bony exposure. This is usually associated with massive contamination.">
				>
				["at0017"] = <
					text = <"Type 3c">
					description = <"Open fracture associated with arterial injury requiring repair.">
				>
			>
		>
	>
