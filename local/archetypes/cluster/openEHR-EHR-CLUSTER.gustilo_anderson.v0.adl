definition
	CLUSTER[at0000] matches {	-- Gustilo Anderson
		items cardinality matches {1..*; unordered} matches {
			ELEMENT[at0012] occurrences matches {0..1} matches {	-- Grad
				value matches {
					DV_CODED_TEXT matches {
						defining_code matches {
							[local::
							at0013, 	-- 1
							at0014, 	-- 2
							at0015, 	-- 3a
							at0016, 	-- 3b
							at0017]	-- 3c
						}
					}
				}
			}
			ELEMENT[at0006] occurrences matches {0..1} matches {	-- Kommentar
				value matches {
					DV_TEXT matches {*}
				}
			}
		}
	}

ontology
	term_definitions = <
		["nb"] = <
			items = <
				["at0000"] = <
					text = <"Gustilo Anderson">
					description = <"Revidert utgave av den originale Gustilo-Anderson klassifiseringen som ble introdusert i 1976">
				>
				["at0006"] = <
					text = <"Kommentar">
					description = <"Nærmere spesifisering">
				>
				["at0012"] = <
					text = <"Grad">
					description = <"Gradering av hudåpning og alvorlighetsgrad">
				>
				["at0013"] = <
					text = <"1">
					description = <"Mindre enn 1 cm hudåpning">
				>
				["at0014"] = <
					text = <"2">
					description = <"Over 1 cm hudåpning, lavenergi">
				>
				["at0015"] = <
					text = <"3a">
					description = <"Høyenergi eller komminutt fraktur uten bløtdelsdefekt">
				>
				["at0016"] = <
					text = <"3b">
					description = <"Høyenergi eller komminutt fraktur med bløtdelsdefekt">
				>
				["at0017"] = <
					text = <"3c">
					description = <"Høyenergi eller komminutt fraktur med behov for karkirurgi ">
				>
			>
		>
	>
