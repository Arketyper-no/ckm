	details = <
		["nb"] = <
			language = <[ISO_639-1::nb]>
			purpose = <"Åpne brudd beskrives etter alvorlighetsgrad, og mengden av energi som knokkelen har blitt utsatt for">
			use = <"Beskrive brudd med hudåpning

">
