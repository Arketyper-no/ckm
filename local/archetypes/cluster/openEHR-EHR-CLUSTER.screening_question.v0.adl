		["ip_acknowledgements"] = <"This artefact includes content from SNOMED Clinical Terms® (SNOMED CT®) which is copyrighted material of the International Health Terminology Standards Development Organisation (IHTSDO). Where an implementation of this artefact makes use of SNOMED CT content, the implementer must have the appropriate SNOMED CT Affiliate license - for more information contact https://www.snomed.org/snomed-ct/get-snomed or info@snomed.org.">
		["revision"] = <"0.0.1-alpha">
	>

definition
	CLUSTER[at0000] matches {    -- Specific screening question
		items cardinality matches {1..*; unordered} matches {
			ELEMENT[at0001] occurrences matches {0..1} matches {    -- Category
				value matches {
					DV_TEXT matches {*}
				}
			}
			ELEMENT[at0002] occurrences matches {0..1} matches {    -- Related code
				value matches {
					DV_TEXT matches {*}
				}
			}
			ELEMENT[at0012] occurrences matches {0..1} matches {    -- Question
				value matches {
					DV_TEXT matches {*}
				}
			}
			ELEMENT[at0003] occurrences matches {0..1} matches {    -- Answer
				value matches {
					DV_BOOLEAN matches {*}
					DV_CODED_TEXT matches {
						defining_code matches {
							[local::
							at0004,    -- Yes
							at0005,    -- No
							at0006,    -- Partially
							at0007,    -- Uncertain
							at0008,    -- Unknown
							at0009]    -- Not applicable
						}
					}
					DV_TEXT matches {*}
					DV_ORDINAL matches {*}
					DV_COUNT matches {*}
					DV_QUANTITY matches {*}
					DV_PROPORTION matches {*}
					DV_DATE_TIME matches {*}
					DV_DURATION matches {*}
				}
			}
			ELEMENT[at0010] occurrences matches {0..1} matches {    -- Comment
				value matches {
					DV_TEXT matches {*}
				}
			}
			allow_archetype CLUSTER[at0011] occurrences matches {0..*} matches {    -- Sub-question
				include
					archetype_id/value matches {/openEHR-EHR-CLUSTER\.screening_question(-[a-zA-Z0-9_]+)*\.v0/}
			}
		}
	}

ontology
	terminologies_available = <"SNOMED-CT", ...>
	term_definitions = <
		["en"] = <
			items = <
				["at0000"] = <
					text = <"Specific screening question">
					description = <"A single question or statement put to an individual as part of a screening questionnaire, together with the answer given.">
				>
				["at0001"] = <
					text = <"Category">
					description = <"The aspect of the subject that the question addresses.">
					comment = <"For example: 'Accommodation need'; 'Transport need'; or 'Accommodation duration'. Records what kind of thing is being asked about, not the section or heading under which the question appears in a form.">
				>
				["at0002"] = <
					text = <"Related code">
					description = <"A code identifying the subject that this question is about, or the question itself.">
					comment = <"For example: 'Hotel accommodation'; or 'Escort'. Coding of 'Related code' with a terminology is preferred, where possible.">
				>
				["at0003"] = <
					text = <"Answer">
					description = <"The answer given to the question or statement.">
					comment = <"In a template, the data element would usually be renamed to the specific question asked, and the choice of data types constrained to the one appropriate for that question. The proposed value set can be replaced in a template.">
				>
				["at0004"] = <
					text = <"Yes">
					description = <"The individual answered in the affirmative.">
				>
				["at0005"] = <
					text = <"No">
					description = <"The individual answered in the negative.">
				>
				["at0006"] = <
					text = <"Partially">
					description = <"The individual answered that the statement is only partly true.">
				>
				["at0007"] = <
					text = <"Uncertain">
					description = <"The individual answered that they are unsure whether the statement is true.">
				>
				["at0008"] = <
					text = <"Unknown">
					description = <"The individual answered that they do not know.">
					comment = <"Distinct from the question not having been answered, which is represented by absence of a value.">
				>
				["at0009"] = <
					text = <"Not applicable">
					description = <"The individual answered that the question does not apply to them.">
				>
				["at0010"] = <
					text = <"Comment">
					description = <"Additional narrative about the question or answer, not captured in other fields.">
				>
				["at0011"] = <
					text = <"Sub-question">
					description = <"A follow-up question that is only asked, or only meaningful, given a particular answer to this question.">
					comment = <"Each follow-up question is recorded as a nested instance of CLUSTER.screening_question. The nested question inherits the recall period of the event in which it is recorded.">
				>
				["at0012"] = <
					text = <"Question">
					description = <"The full question or statement as presented to the individual.">
					comment = <"For example: 'Do you need a hotel during the treatment period?'.">
				>
			>
		>
		["nb"] = <
			items = <
				["at0000"] = <
					text = <"Spesifikt kartleggingsspørsmål">
					description = <"Ett enkelt spørsmål eller utsagn som presenteres for et individ i et kartleggingsskjema, sammen med svaret som ble gitt.">
				>
				["at0001"] = <
					text = <"Kategori">
					description = <"Det aspektet ved emnet som spørsmålet gjelder.">
					comment = <"For eksempel: \"Behov for overnatting\", \"Behov for transport\" eller \"Varighet av overnatting\". Angir hva slags forhold det spørres om, ikke seksjonen eller overskriften spørsmålet står under i et skjema.">
				>
				["at0002"] = <
					text = <"Relatert kode">
					description = <"En kode som identifiserer emnet spørsmålet handler om, eller spørsmålet selv.">
					comment = <"For eksempel: \"Hotellopphold\" eller \"Ledsager\". Koding av \"Relatert kode\" med en terminologi foretrekkes, der det er mulig.">
				>
				["at0003"] = <
					text = <"Svar">
					description = <"Svaret som ble gitt på spørsmålet eller utsagnet.">
					comment = <"I et templat vil dataelementet vanligvis døpes om til det spesifikke spørsmålet som stilles, og valget av datatyper begrenses til den som passer for spørsmålet. Det foreslåtte verdisettet kan erstattes i et templat.">
				>
				["at0004"] = <
					text = <"Ja">
					description = <"Individet svarte bekreftende.">
				>
				["at0005"] = <
					text = <"Nei">
					description = <"Individet svarte benektende.">
				>
				["at0006"] = <
					text = <"Delvis">
					description = <"Individet svarte at utsagnet bare delvis stemmer.">
				>
				["at0007"] = <
					text = <"Usikker">
					description = <"Individet svarte at hen er usikker på om utsagnet stemmer.">
				>
				["at0008"] = <
					text = <"Ukjent">
					description = <"Individet svarte at hen ikke vet.">
					comment = <"Er noe annet enn at spørsmålet ikke er besvart, som representeres ved at verdien mangler.">
				>
				["at0009"] = <
					text = <"Ikke aktuelt">
					description = <"Individet svarte at spørsmålet ikke gjelder for hen.">
				>
				["at0010"] = <
					text = <"Kommentar">
					description = <"Ytterligere fritekst om spørsmålet eller svaret, som ikke er omfattet av andre felt.">
				>
				["at0011"] = <
					text = <"Underspørsmål">
					description = <"Et oppfølgingsspørsmål som bare stilles, eller bare gir mening, ved et bestemt svar på dette spørsmålet.">
					comment = <"Hvert oppfølgingsspørsmål registreres som en nøstet instans av CLUSTER.screening_question. Det nøstede spørsmålet arver tidsperioden til hendelsen det registreres i.">
				>
				["at0012"] = <
					text = <"Spørsmål">
					description = <"Det fullstendige spørsmålet eller utsagnet slik det ble presentert for individet.">
					comment = <"For eksempel: \"Trenger du hotell i behandlingsperioden?\".">
				>
			>
		>
	>
	term_bindings = <
		["SNOMED-CT"] = <
			items = <
				["at0004"] = <[SNOMED-CT::373066001]>
				["at0005"] = <[SNOMED-CT::373067005]>
				["at0008"] = <[SNOMED-CT::261665006]>
			>
		>
	>
